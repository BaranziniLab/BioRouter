#!/bin/sh
# Reject commits containing AI co-author attribution lines.

if grep -qiE "^Co-Authored-By:.*anthropic|^Co-Authored-By:.*claude|^Co-Authored-By:.*openai|^Co-Authored-By:.*chatgpt|^Co-Authored-By:.*gemini|^Co-Authored-By:.*copilot" "$1"; then
  echo "error: commit message contains an AI co-author line."
  echo "       Remove the 'Co-Authored-By:' trailer and try again."
  exit 1
fi
